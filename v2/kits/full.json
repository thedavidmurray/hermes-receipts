             "tool_call_count", "top_tools", "tokens_in", "tokens_out", "tokens_total", "cost", "cost_scope",
             "duration", "files_touched", "claims_detected", "verdict_per_claim", "evidence_locators",
             "artifact_version", "detector_version", "matcher_version", "plugin_version", "git_sha",
             "receipt_hash", "timestamp"]
}
